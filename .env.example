# Copy to .env for local testing with `vercel dev` or `netlify dev`.
# In production, set these in the Vercel / Netlify dashboard.

# Email delivery for forms (https://resend.com). Sender domain must be verified.
RESEND_API_KEY=
FORMS_FROM_EMAIL="F.Y.C. / N.Y.C. Website <website@thefycnyc.com>"
EVENTS_TO_EMAIL=events@thefycnyc.com
JOIN_TO_EMAIL=info@thefycnyc.com

# Cloudflare Turnstile (the public site key goes in src/data/site.json > forms.turnstileSiteKey)
TURNSTILE_SECRET_KEY=


# Join the Family provider: mailchimp | klaviyo | email
# Leave SUBSCRIBER_PROVIDER blank: Mailchimp is used once MAILCHIMP_API_KEY is set.
SUBSCRIBER_PROVIDER=
KLAVIYO_API_KEY=
KLAVIYO_LIST_ID=
MAILCHIMP_API_KEY=
MAILCHIMP_LIST_ID=
