---
/**
 * One menu row. Featured items get a "Pairs with" line (no photos on menu pages).
 * Prices print without "$" (menu convention); screen readers still hear dollars.
 */

export interface Item {
  name: string | null;
  description?: string | null;
  price?: number | null;
  glass?: number | null;
  bottle?: number | null;
  tags?: string[];
  featured?: boolean | number;
  pairing?: string | null;
  image?: string | null;
  placeholder?: boolean;
}
interface Props {
  item: Item;
  tagLabels: Record<string, string>;
}
const { item, tagLabels } = Astro.props;

const tags = item.tags ?? [];
const featured = Boolean(item.featured);
const isWine = item.glass !== undefined || item.bottle !== undefined;
---
<li class:list={['mi', { 'mi--feat': featured, 'mi--ph': item.placeholder }, ...tags.map((t) => `is-${t}`)]}>
  <div class="mi__body">
    <div class="mi__top">
      <h3 class="mi__name">{item.name}</h3>
      <span class="mi__price">
        {isWine ? (
          <>
            {item.glass != null && <span><span class="sr-only">Glass $</span>{item.glass}</span>}
            {item.glass != null && item.bottle != null && <span aria-hidden="true"> / </span>}
            {item.bottle != null && <span><span class="sr-only">, bottle $</span>{item.bottle}</span>}
          </>
        ) : item.price != null && (
          <><span class="sr-only">$</span>{item.price}</>
        )}
      </span>
    </div>
    {item.description && <p class="mi__desc">{item.description}</p>}
    {featured && item.pairing && <p class="mi__pair">Pairs with: {item.pairing}</p>}
    {tags.length > 0 && (
      <ul class="tags mi__tags" role="list">
        {tags.map((t) => <li class:list={['tag', { 'tag--v': t === 'vegetarian' }]}>{tagLabels[t] ?? t}</li>)}
      </ul>
    )}
  </div>
</li>

<style>
  .mi {
    padding: 16px 0;
    border-bottom: 1px solid var(--paper-line);
    list-style: none;
  }
  .mi__top { display: flex; justify-content: space-between; align-items: baseline; gap: 16px; }
  .mi__name {
    font-family: var(--body);
    font-size: 17px;
    font-weight: 700;
    line-height: 1.35;
    letter-spacing: .005em;
    color: var(--ink);
    text-wrap: pretty;
  }
  .mi__price { flex: none; font-weight: 800; color: var(--gold-dk); font-size: 16px; font-variant-numeric: tabular-nums; }
  .mi__desc { font-size: 15px; color: var(--paper-mute) !important; margin: 3px 0 6px; line-height: 1.5; }
  .mi__pair { font-size: 13.5px; font-weight: 600; color: var(--gold-dk) !important; margin-top: 2px; }
  .mi__pair::before { content: '◆ '; font-size: 9px; vertical-align: 2px; }
  .mi__tags { margin-top: 8px; }
  .mi--ph .mi__name { color: var(--paper-mute); font-weight: 600; }
</style>
