---
/**
 * <BookingWidget />
 *
 * Two booking buttons: Resy and OpenTable. Each opens the restaurant's page
 * on that platform in a new tab (links in site.json > booking).
 */
import site from '../data/site.json';

interface Props {
  id?: string;
}
const { id = 'booking-widget' } = Astro.props;
---
<div class="bw" id={id}>
  <p class="bw__lead">Pick a time on either platform.</p>
  <div class="bw__links">
    <a class="btn btn--primary btn--block" href={site.booking.resyUrl} target="_blank" rel="noopener" data-track="booking_start" data-track-provider="resy">
      Book on Resy<span class="sr-only"> (opens in a new tab)</span>
    </a>
    <a class="btn btn--block" href={site.booking.opentableUrl} target="_blank" rel="noopener" data-track="booking_start" data-track-provider="opentable">
      Book on OpenTable<span class="sr-only"> (opens in a new tab)</span>
    </a>
  </div>
</div>

<style>
  .bw__lead { margin: 0 0 18px; color: var(--soft); font-size: 15px; }
  .bw__links { display: grid; gap: 10px; }
  @media (min-width: 560px) {
    .bw__links { grid-template-columns: 1fr 1fr; }
  }
</style>
